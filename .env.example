# ── General ──
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bloger_bot
POSTGRES_USER=bloger_bot
POSTGRES_PASSWORD=changeme_postgres_password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ── ChromaDB ──
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── OpenAI ──
OPENAI_API_KEY=sk-your-key-here
# Optional: pipeline v2 uses CHAT_MODEL for final reply; OPENAI_STAGE_MODEL for analysis/hypothesis/rerank/judge
# CHAT_MODEL=gpt-4o
# OPENAI_STAGE_MODEL=gpt-4o-mini
# LLM_DEBUG_STAGES=1

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
# If api.telegram.org is blocked: set OUTBOUND_PROXY_URL (bot uses it explicitly; also sets HTTP(S)_PROXY for httpx)
# OUTBOUND_PROXY_URL=http://user:pass@proxy-host:port

# ── Telegram Parsing ──
TELEGRAM_SESSION_NAME=content_parser
TELEGRAM_SOURCE_CHANNELS=-1002210824560,-1003898782970 #материалы, исходники

# ── AmoCRM ──
AMOCRM_ENABLED=false
AMOCRM_DOMAIN=your-domain.amocrm.ru
AMOCRM_ACCESS_TOKEN=your-access-token
AMOCRM_REFRESH_TOKEN=your-refresh-token
AMOCRM_CLIENT_ID=your-client-id
AMOCRM_CLIENT_SECRET=your-client-secret
AMOCRM_REDIRECT_URI=https://your-app.example.com/callback

# ── Celery ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Services Ports ──
CONTENT_SERVICE_PORT=8001
INGESTION_SERVICE_PORT=8002
LLM_SERVICE_PORT=8003
USER_SERVICE_PORT=8004
TELEGRAM_BOT_SERVICE_PORT=8005
PAYMENT_SERVICE_PORT=8006
ANALYTICS_SERVICE_PORT=8007
CRM_SERVICE_PORT=8008
PROACTIVE_PING_SERVICE_PORT=8009

# ── Whisper (local) ──
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=ru
TRANSCRIPTION_OUTPUT_DIR=./data/transcriptions
DOWNLOAD_DIR=./data/downloads