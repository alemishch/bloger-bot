{
  "comment": "Paths to sync to Google Drive (gitignored / runtime data). All paths relative to repo root.",
  "remote_name": "gdrive",
  "remote_folder": "bloger-bot-sync",
  "docker_compose_file": "docker-compose.dev.yml",
  "include_downloads": false,
  "include_docker_chroma": true,
  "staging_chroma_subdir": "chroma_docker_volume",
  "paths": [
    "sessions",
    "data/transcriptions",
    "data/labeled",
    "data/exports",
    "data/rag",
    "data/yadisk_transcripts",
    "data/youtube_transcripts",
    "data/instagram_transcripts",
    "chroma_db",
    "vector_store",
    "chromadb",
    "qdrant_storage"
  ],
  "session_files": [
    "*.session",
    "tools/*.session"
  ],
  "include_postgres_dump": true,
  "exclude_env_and_secrets": true
}
